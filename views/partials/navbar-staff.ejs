<header class="p-3 text-bg-dark">
    <div class="container">
        <div
            class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start"
        >
            
            <ul
                class="nav col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0"
            >
                <li>
                    <a href="<%= isAdmin ? '/admin' : '/staff' %>" class="nav-link px-2 text-secondary">Dashboard</a>
                </li>

                <li>
                    <a href="<%= isAdmin ? '/admin/analytics' : '/staff/analytics' %>" class="nav-link px-2 text-white">Review Analytics</a>
                </li>
            </ul>
            

            <div class="d-flex gap-2">
                <p class="pt-3"><%= email %></p>
                <form action="/logout" method="POST">
                    <button type="submit" class="btn btn-outline-light mt-2">
                        Logout
                    </button>
                </form>
            </div>
        </div>
    </div>
</header>