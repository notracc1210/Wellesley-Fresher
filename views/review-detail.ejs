<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Wellesley-Fresh-Review-Detail</title>

		<link
			href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
			rel="stylesheet"
		/>

		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	</head>

	<body>
		<header class="p-3 text-bg-dark">
			<div class="container">
				<div
					class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start"
				>
					<a
						href="/home"
						class="d-flex align-items-center mb-2 mb-lg-0 text-white text-decoration-none"
					>
						<svg
							class="bi me-2"
							width="40"
							height="32"
							role="img"
							aria-label="Bootstrap"
						>
							<use xlink:href="#bootstrap"></use>
						</svg>
					</a>
					<ul
						class="nav col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0"
					>
						<li>
							<a href="/staff" class="nav-link px-2 text-secondary"
								>Dashboard</a
							>
						</li>

						<li>
							<a href="#" class="nav-link px-2 text-white">Review Analytics</a>
						</li>
					</ul>
					

					<div class="d-flex gap-2">
						<p class="pt-3"><%= email %></p>
						<form action="/logout" method="POST">
							<button type="submit" class="btn btn-outline-light mt-2">
								Logout
							</button>
						</form>
					</div>
				</div>
			</div>
		</header>

		<div class="px-4 pt-5 my-5 text-center border-bottom">
			<h1 class="display-4 fw-bold text-body-emphasis mb-5">#<%= reviewID %></h1>
		</div>

		<div class="container px-4 py-5">
			<h2 class="pb-2">Details</h2>
            <table class="table table-sm table-bordered">
            <thead>
                <tr>
                    <th scope="col" style="width: 20%;">Type</th>
                    <th scope="col">Detail</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">Dining Hall</th>
                    <td><%= review.diningHall%></td>
                </tr>
                <tr>
                    <th scope="row">Meal Time</th>
                    <td><%= review.mealTime%></td>
                </tr>
                <tr>
                    <th scope="row">Rating</th>
                    <td>⭐️<%= review.rating%></td>
                </tr>
                <tr>
                    <th scope="row">Review Text</th>
                    <td><%= review.reviewText%></td>
                </tr>
                <tr>
                    <th scope="row">Cateogry</th>
                    <td><%= review.category%></td>
                </tr>
            </tbody>
          </table>
		</div>
	</body>
</html>
