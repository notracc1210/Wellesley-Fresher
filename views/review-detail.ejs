<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Wellesley-Fresh-Review-Detail</title>

		<link
			href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
			rel="stylesheet"
		/>

		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	</head>

	<body>
		
		<%- include('partials/navbar-staff') %>

		<div class="px-4 pt-5 my-5 text-center border-bottom">
			<h1 class="display-4 fw-bold text-body-emphasis mb-5">#<%= reviewID %></h1>
		</div>

		<div class="container px-4 py-5">
			<h2 class="pb-2">Details</h2>
            <table class="table table-sm table-bordered">
            <thead>
                <tr>
                    <th scope="col" style="width: 20%;">Type</th>
                    <th scope="col">Detail</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">Dining Hall</th>
                    <td><%= review.diningHall%></td>
                </tr>
                <tr>
                    <th scope="row">Meal Time</th>
                    <td><%= review.mealTime%></td>
                </tr>
                <tr>
                    <th scope="row">Rating</th>
                    <td>⭐️<%= review.rating%></td>
                </tr>
                <tr>
                    <th scope="row">Review Text</th>
                    <td><%= review.reviewText%></td>
                </tr>
                <tr>
                    <th scope="row">Category</th>
                    <td><%= review.category%></td>
                </tr>
            </tbody>
          </table>
		  <% if (review.imagePath) { %>
			<img
				src="<%= review.imagePath %>"
				alt="Uploaded review image"
				class="img-fluid rounded my-3"
				style="max-width: 400px;"
			>
		<% } %>
		</div>
	</body>
</html>
