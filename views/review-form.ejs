<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Submit a Review - Wellesley Fresher</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </head>

  <body>
    
    <%- include('partials/navbar-student') %>

    <div class="px-4 pt-5 my-5 text-center border-bottom">
      <h1 class="display-4 fw-bold text-body-emphasis">Share Your Feedback</h1>
      <div class="col-lg-6 mx-auto">
        <p class="lead mb-4">
          Help us improve the dining experience at Wellesley by sharing your honest feedback about our dining halls.
        </p>
      </div>
    </div>

    <div class="container my-5">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card shadow-lg">
            <div class="card-body p-5">
              <h2 class="card-title mb-4">Review Form</h2>

              <%- include('partials/review-form-fields', {
                action: "/submit-review",
                submitLabel: "Submit Review",
                review: {},
                isEdit: false
              }) %>

            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="container px-4 py-5 border-top">
      <div class="row">
        <div class="col-md-4 mb-4">
          <div class="text-center">
            <h5 class="fw-bold">Be Genuine</h5>
            <p class="text-muted">Share your genuine thoughts to help improve our dining services!</p>
          </div>
        </div>
        <div class="col-md-4 mb-4">
          <div class="text-center">
            <h5 class="fw-bold">Safe & Secure</h5>
            <p class="text-muted">Your feedback is handled with care and can be posted anonymously.</p>
          </div>
        </div>
        <div class="col-md-4 mb-4">
          <div class="text-center">
            <h5 class="fw-bold">Make an Impact</h5>
            <p class="text-muted">Your reviews help create positive change in our dining community.</p>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>