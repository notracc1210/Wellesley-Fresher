<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Review Analytics - Wellesley Fresher</title>

	<link
		href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
		rel="stylesheet"
	>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>
	<%- include('partials/navbar-staff') %>

	<div class="container py-5">
		<div class="text-center mb-5">
			<h1 class="display-4 fw-bold text-body-emphasis">
				Review Analytics
			</h1>

			<p class="lead text-muted">
				Filter reviews by date range, dining hall, and meal time to see the average rating.
			</p>
		</div>

		<div class="row justify-content-center">
			<div class="col-lg-10">

				<section class="mb-5">
					<h2 class="h4 fw-bold mb-4">
						Filters
					</h2>

					<form method="GET" action="<%= analyticsPath %>" class="d-flex flex-wrap gap-3 align-items-center justify-content-center">
						<%- include('partials/filter-dropdowns') %>

						<label for="startDate" class="visually-hidden">Start Date</label>
						<input
							type="date"
							id="startDate"
							name="startDate"
							value="<%= startDate %>"
							class="form-control"
							style="width: 150px;"
						/>

						<label for="endDate" class="visually-hidden">End Date</label>
						<input
							type="date"
							id="endDate"
							name="endDate"
							value="<%= endDate %>"
							class="form-control"
							style="width: 150px;"
						/>

						<button type="submit" class="btn btn-primary">
							Apply Filters
						</button>
					</form>
				</section>

				<section class="text-center mt-5 pt-4">
					<h2 class="h4 fw-bold mb-3">
						Average Rating
					</h2>

					<% if (reviewCount > 0) { %>
						<div class="display-2 fw-bold text-primary mb-2">
							<%= avgRating.toFixed(2) %>
						</div>

						<p class="lead mb-1">
							out of 5
						</p>

						<p class="text-muted mb-0">
							Based on <%= reviewCount %> review<%= reviewCount === 1 ? "" : "s" %>
						</p>
					<% } else { %>
						<p class="text-muted mb-0">
							No reviews match these filters.
						</p>
					<% } %>
				</section>

				<div class="text-center mt-4">
					<a href="<%= dashboardPath %>" class="btn btn-outline-dark rounded-pill px-4">
						Back to Dashboard
					</a>
				</div>

			</div>
		</div>
	</div>
</body>
</html>
