<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Review Analytics - Wellesley Fresher</title>

	<link
		href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
		rel="stylesheet"
	>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>
	<%- include('partials/navbar-staff') %>

	<%
		const diningHallOptions = [
			"Bates Hall",
			"Tower Court",
			"Lulu Chow Wang Center",
			"Stone Davis",
			"Collins Cafe",
			"Saxbys",
			"Other"
		];

		const mealTimeOptions = [
			"Breakfast",
			"Brunch",
			"Lunch",
			"Dinner"
		];

		const selectedHalls = selectedDiningHalls || [];
		const selectedMeals = selectedMealTime || [];
	%>

	<div class="container py-5">
		<div class="text-center mb-5">
			<h1 class="display-4 fw-bold text-body-emphasis">
				Review Analytics
			</h1>

			<p class="lead text-muted">
				Filter reviews by date range, dining hall, and meal time to see the average rating.
			</p>
		</div>

		<div class="row justify-content-center">
			<div class="col-lg-10">

				<section class="mb-5">
					<h2 class="h4 fw-bold mb-4">
						Filters
					</h2>

					<form method="GET" action="<%= analyticsPath %>" class="d-flex flex-wrap gap-3 align-items-center justify-content-center">

	<div class="dropdown-DiningHall">
		<button
			class="btn btn-outline-dark dropdown-toggle"
			type="button"
			data-bs-toggle="dropdown"
		>
			Dining Hall
		</button>

		<ul class="dropdown-menu p-3" data-bs-auto-close="outside">
			<li>
				<label class="dropdown-item">
					<input
						type="checkbox"
						name="diningHall"
						value="Bates Hall"
						<%= selectedDiningHalls.includes("Bates Hall") ? "checked" : "" %>
					>
					Bates
				</label>
			</li>

			<li>
				<label class="dropdown-item">
					<input
						type="checkbox"
						name="diningHall"
						value="Tower Court"
						<%= selectedDiningHalls.includes("Tower Court") ? "checked" : "" %>
					>
					Tower
				</label>
			</li>

			<li>
				<label class="dropdown-item">
					<input
						type="checkbox"
						name="diningHall"
						value="Lulu Chow Wang Center"
						<%= selectedDiningHalls.includes("Lulu Chow Wang Center") ? "checked" : "" %>
					>
					Lulu
				</label>
			</li>

			<li>
				<label class="dropdown-item">
					<input
						type="checkbox"
						name="diningHall"
						value="Stone Davis"
						<%= selectedDiningHalls.includes("Stone Davis") ? "checked" : "" %>
					>
					Stone Davis
				</label>
			</li>

			<li>
				<label class="dropdown-item">
					<input
						type="checkbox"
						name="diningHall"
						value="Collins Cafe"
						<%= selectedDiningHalls.includes("Collins Cafe") ? "checked" : "" %>
					>
					Collins Cafe
				</label>
			</li>

			<li>
				<label class="dropdown-item">
					<input
						type="checkbox"
						name="diningHall"
						value="Saxbys"
						<%= selectedDiningHalls.includes("Saxbys") ? "checked" : "" %>
					>
					Saxbys
				</label>
			</li>

			<li>
				<label class="dropdown-item">
					<input
						type="checkbox"
						name="diningHall"
						value="Other"
						<%= selectedDiningHalls.includes("Other") ? "checked" : "" %>
					>
					Other
				</label>
			</li>
		</ul>
	</div>

	<div class="dropdown-MealTime">
		<button
			class="btn btn-outline-dark dropdown-toggle"
			type="button"
			data-bs-toggle="dropdown"
		>
			Meal Time
		</button>

		<ul class="dropdown-menu p-3" data-bs-auto-close="outside">
			<li>
				<label class="dropdown-item">
					<input
						type="checkbox"
						name="mealTime"
						value="Breakfast"
						<%= selectedMealTime.includes("Breakfast") ? "checked" : "" %>
					>
					Breakfast
				</label>
			</li>

			<li>
				<label class="dropdown-item">
					<input
						type="checkbox"
						name="mealTime"
						value="Brunch"
						<%= selectedMealTime.includes("Brunch") ? "checked" : "" %>
					>
					Brunch
				</label>
			</li>

			<li>
				<label class="dropdown-item">
					<input
						type="checkbox"
						name="mealTime"
						value="Lunch"
						<%= selectedMealTime.includes("Lunch") ? "checked" : "" %>
					>
					Lunch
				</label>
			</li>

			<li>
				<label class="dropdown-item">
					<input
						type="checkbox"
						name="mealTime"
						value="Dinner"
						<%= selectedMealTime.includes("Dinner") ? "checked" : "" %>
					>
					Dinner
				</label>
			</li>
		</ul>
	</div>

	<input
		type="date"
		name="startDate"
		value="<%= startDate %>"
		class="form-control"
		style="width: 140px;"
	>

	<input
		type="date"
		name="endDate"
		value="<%= endDate %>"
		class="form-control"
		style="width: 140px;"
	>

	<button type="submit" class="btn btn-primary">
		Apply Filters
	</button>

</form>
				</section>

				<section class="text-center mt-5 pt-4">
					<h2 class="h4 fw-bold mb-3">
						Average Rating
					</h2>

					<% if (reviewCount > 0) { %>
						<div class="display-2 fw-bold text-primary mb-2">
							<%= avgRating.toFixed(2) %>
						</div>

						<p class="lead mb-1">
							out of 5
						</p>

						<p class="text-muted mb-0">
							Based on <%= reviewCount %> review<%= reviewCount === 1 ? "" : "s" %>
						</p>
					<% } else { %>
						<p class="text-muted mb-0">
							No reviews match these filters.
						</p>
					<% } %>
				</section>

				<div class="text-center mt-4">
					<a href="<%= dashboardPath %>" class="btn btn-outline-dark rounded-pill px-4">
						Back to Dashboard
					</a>
				</div>

			</div>
		</div>
	</div>
</body>
</html>