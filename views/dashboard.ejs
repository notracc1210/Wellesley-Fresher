<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Wellesley-Fresh-Dashboard</title>

		<link
			href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
			rel="stylesheet"
		/>

		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	</head>

	<body>
		
		<%- include('partials/navbar-staff') %>

		<div class="px-4 pt-5 my-5 text-center border-bottom">
			<h1 class="display-4 fw-bold text-body-emphasis mb-5">
				<%= isAdmin ? "Admin Dashboard" : "Staff Dashboard" %>
			</h1>
		</div>

		<div class="container px-4 py-5" id="custom-cards">
			<h2 class="pb-2 border-bottom">Reviews</h2>
			<form method="GET" action="<%= isAdmin ? '/admin' : '/staff' %>" class="d-flex flex-wrap gap-3 align-items-center mb-4">
			<input type="hidden" name="page" value="1">

			<input
				type="search"
				class="form-control"
				placeholder="Search for reviews"
				aria-label="Search"
				name="search"
				value="<%= search %>"
				style="width: 200px;"
			/>

			<%- include('partials/filter-dropdowns') %>

			<label for="startDate" class="visually-hidden">Start Date</label>
			<input
				type="date"
				id="startDate"
				name="startDate"
				value="<%= startDate %>"
				class="form-control"
				style="width: 150px;"
			/>

			<label for="endDate" class="visually-hidden">End Date</label>
			<input
				type="date"
				id="endDate"
				name="endDate"
				value="<%= endDate %>"
				class="form-control"
				style="width: 150px;"
			/>

			<button type="submit" class="btn btn-primary">Apply filters</button>
		</form>
		<div class="column row-cols-1 align-items-stretch py-5">

			<% reviews.forEach(review => { %>
				<div class="col mb-3">
					<div class="card card-cover h-100 overflow-hidden text-bg-light">
						<h3 class="card-header h5 mb-0">#<%= review.reviewID %></h3>
						<div class="d-flex flex-column h-100 p-5 pb-3 text-dark">
							<p style="font-size: 15px;">⭐️<%= review.rating %></p>
							<h4 style="font-size: 22px;"><%= review.reviewText %></h4>
							<ul class="d-flex list-unstyled mt-auto">
								<li class="d-flex align-items-center me-3">
									<small><a href="<%= isAdmin ? '/admin' : '/staff' %>/review-detail/<%= review.reviewID %>">
										View Detail
									</a></small>
								</li>
								<li class="me-auto"></li>
								<li class="d-flex align-items-center me-3">
									<small><%= review.diningHall %></small>
								</li>
								<li class="d-flex align-items-center me-3">
									<small><%= review.mealTime %></small>
								</li>
								<li class="d-flex align-items-center">
									<small><%= new Date(review.dateUploaded).toLocaleDateString('en-US', {month: 'long', day: 'numeric'}) %></small>
								</li>
							</ul>
						</div>
					</div>
				</div>
			<% }) %>


			<nav class="d-flex justify-content-center align-items-center gap-2 mt-4">
				<% const dashboardPath = isAdmin ? "/admin" : "/staff"; %>
				<% if (page > 1) { %>
					<a class="btn btn-outline-dark" href="<%= pageUrl(page - 1) %>" aria-label="Previous page">←</a>
				<% } else { %>
					<button class="btn btn-outline-secondary" disabled aria-label="Previous page">←</button>
				<% } %>

				<form method="GET" action="<%= dashboardPath %>" class="d-flex align-items-center gap-2">
					<% selectedDiningHalls.forEach(hall => { %>
						<input type="hidden" name="diningHall" value="<%= hall %>">
					<% }) %>
					<% selectedMealTime.forEach(time => { %>
						<input type="hidden" name="mealTime" value="<%= time %>">
					<% }) %>
					<input type="hidden" name="startDate" value="<%= startDate %>">
					<input type="hidden" name="endDate" value="<%= endDate %>">

					<label for="pageInput" class="visually-hidden">Page number</label>
						<input
							type="number"
							name="page"
							value="<%= page %>"
							min="1"
							max="<%= totalPages %>"
							class="form-control text-center"
							style="width: 80px;"
							id="pageInput"
						/>

					<span>of <%= totalPages %></span>

					<button type="submit" class="btn btn-primary">Go</button>
				</form>

				<% if (page < totalPages) { %>
					<a class="btn btn-outline-dark" href="<%= pageUrl(page + 1) %>" aria-label="Next page">→</a>
				<% } else { %>
					<button class="btn btn-outline-secondary" disabled aria-label="Next page">→</button>
				<% } %>
			</nav>
		</div>

		</div>
	</body>
</html>
