<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Wellesley-Fresh-Admin-Edit-Reivew</title>

		<link
			href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
			rel="stylesheet"
		/>

		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	</head>

	<body>
		<%- include('partials/navbar-staff') %>

        <div class="px-4 pt-5 my-5 text-center border-bottom">
        <h1 class="display-4 fw-bold text-body-emphasis">Edit Review</h1>
        <div class="col-lg-6 mx-auto">
            <p class="lead mb-4">
            Update this review’s information below.
            </p>
        </div>
        </div>

        <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
            <div class="card shadow-lg">
                <div class="card-body p-5">
                <h2 class="card-title mb-4">
                    Review #<%= review.reviewID %>
                </h2>

                <%- include('partials/review-form-fields', {
                    action: "/admin/review/" + review.reviewID + "/edit",
                    submitLabel: "Save Changes",
                    review: review,
                    isEdit: true
                }) %>

                </div>
            </div>
            </div>
        </div>
        </div>
	</body>
</html>
