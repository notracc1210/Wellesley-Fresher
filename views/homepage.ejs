<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wellesley-Fresher-Homepage</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </head>

  <body>
    
    <%- include('partials/navbar-student') %>

    <div class="px-4 pt-5 my-5 text-center border-bottom">
      <h1 class="display-4 fw-bold text-body-emphasis">Wellesley Fresher</h1>
      <div class="col-lg-6 mx-auto">
        <p class="lead mb-4">
          Welcome to Wellesley Fresher! Let's make our dining hall services better!
        </p>
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mb-5">
          <button type="button" class="btn btn-primary btn-lg px-4 me-sm-3" onclick="window.location.href='/review-form'">
            Provide Your Feedback Today
          </button>
        </div>
      </div>
      <div class="overflow-hidden" style="max-height: 30vh">
      </div>
    </div>

    <div class="container px-4 py-5" id="custom-cards">
      <h2 class="pb-2 border-bottom">Recent Reviews</h2>
      <div class="row row-cols-2 row-cols-lg-3 align-items-stretch g-4 py-5">
        
        <% display_reviews.forEach(review => { %>
          <div class="col">
            <div class="card card-cover h-100 overflow-hidden text-bg-dark rounded-4 shadow-lg"
                style="background-image: url(&quot;unsplash-photo-1.jpg&quot;)">
              <div class="d-flex flex-column h-100 p-5 pb-3 text-white text-shadow-1">
                <h3 class="pt-5 mt-5 mb-4 display-6 lh-1 fw-bold">
                  <%= review.reviewText %>
                </h3>
                <ul class="d-flex list-unstyled mt-auto">
                  <li class="d-flex align-items-center me-3">
                    <small><%= review.diningHall %></small>
                  </li>
                  <li class="d-flex align-items-center">
                    <small><%= new Date(review.dateUploaded).toLocaleDateString('en-US', {month: 'long', day: 'numeric'}) %></small>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        <% }) %>  
              
    </div>
  </body>
</html>
